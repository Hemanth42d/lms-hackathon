# Environment Configuration for Backend (Render)

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/lms?retryWrites=true&w=majority

# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend URLs (for CORS) - Update with your Vercel deployment URL
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here

# Gemini API key for video summarization feature

GEMINI_API_KEY=your_gemini_api_key_here